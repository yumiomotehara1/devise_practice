<h2>マイページ画面</h2>

<table border="1" style="border-collapse: collapse; width: 100%; max-width: 500px; text-align: left;">
  <tr>
    <th style="background-color: #f2f2f2; width: 30%; padding: 5px;">名前</th>
    <td style="padding: 5px;"><%= current_user.name %></td>
  </tr>
  <tr>
    <th style="background-color: #f2f2f2; padding: 5px;">メールアドレス</th>
    <td style="padding: 5px;"><%= current_user.email %></td>
  </tr>
</table>

<p>
  <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %>
</p>
