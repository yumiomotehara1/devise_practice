<style>
  /* 入力欄の幅を画像と同じサイズに固定 */
  input[type="text"], input[type="email"], input[type="password"] {
    width: 200px;
    box-sizing: border-box;
  }

  /* 入力欄のブロック（field）の中にある文字とボックスの上下の隙間をなくす */
  .field p {
    margin-top: 2px;
    margin-bottom: 2px;
  }

  /* 一番下にある3つのリンク（サインアップ等）の上下の余白を少し狭くする */
  p {
    margin-top: 4px;
    margin-bottom: 4px;
  }
</style>


<h2>ログイン画面</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

  <div class="field">
    <p><%= f.label :email, "メールアドレス" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password, "パスワード" %></p>
    <p><%= f.password_field :password, autocomplete: "current-password" %></p>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field">
      <p>
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "ログイン状態を保持" %>
      </p>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "ログイン" %>
  </div>

<% end %>

<p>
  <%= link_to "サインアップ", new_user_registration_path %>
</p>

<p>
  <%= link_to "パスワードをお忘れですか？", new_user_password_path %>
</p>

<p>
  <%= link_to "トップ画面に戻る", root_path %>
</p>
